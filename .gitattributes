# 换行统一为 LF：跨平台检出结果一致，避免 diff 噪音与 shebang 脚本在 POSIX 上失效
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.svd   text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
LICENSE text eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.pdf  binary
*.pyc  binary
